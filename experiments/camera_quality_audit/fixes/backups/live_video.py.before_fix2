"""Live-video transport settings for the dashboard (camera-quality programme, 2026-11-23).

Fix 1: return-video bitrate. The annotated frames are sent back to the browser by aiortc's VP8 encoder, whose library
defaults are a constant-bitrate target of 0.5 Mbit/s (start), 0.25 Mbit/s (floor) and 1.5 Mbit/s (cap). On this
local-only application that compresses the returned video far more than necessary (CAMERA-QUALITY-REPORT-001 §3).
`configure_return_video_bitrate()` replaces those three module constants once per process, before any stream starts.
The encoder still adapts within [min, max] to the browser's bandwidth feedback (REMB). No library file is edited.

Fix 3: `VIDEO_HTML_ATTRS` makes the <video> element show the stream at most at its own resolution (no upscaling),
keep its aspect ratio and never crop.

The values were chosen by benchmark: experiments/camera_quality_audit/reports/CAMERA-FIX-REPORT-004-fix1-bitrate.md.

Start guard: streamlit-webrtc 0.79.1 stores Streamlit's count of finished runs at every render and treats a later
difference above one as "the component was off screen", which stops the live worker. During the burst of reruns after
START the count can jump by two although the user never left the page, so a healthy connection was closed about 0.44 s
after START (CAMERA-START-FAILURE-DIAGNOSTIC-001). While every run since the last render stayed on the page that shows
the video, `protect_live_stream` clears the stored value just before `webrtc_streamer` is called. None is the library's
own "no previous render" state, so its check is skipped for that call only. A run that does not render the component
sets a marker, which keeps the library's reset fully active for genuine page changes.
"""

from __future__ import annotations

from collections.abc import MutableMapping
from functools import lru_cache
from importlib import metadata
from typing import Any

# Chosen return-video VP8 bitrate (bits per second). See the benchmark report before changing.
# 4 Mbit/s is the lowest setting that met the stability, CPU and quality rule; every tested setting up to 8 Mbit/s was stable.
RETURN_VIDEO_BITRATE = {"default": 4_000_000, "min": 2_000_000, "max": 4_000_000}

# <video> attributes for streamlit-webrtc: natural size (no upscaling beyond the stream resolution), centred,
# aspect ratio preserved, never cropped, never wider than the column.
VIDEO_HTML_ATTRS = {
    "autoPlay": True,
    "controls": False,
    "muted": True,
    "style": {"width": "auto", "maxWidth": "100%", "height": "auto", "display": "block", "margin": "0 auto",
              "objectFit": "contain", "background": "#0d0f12"},
}

# The start guard relies on one private attribute of this exact library version. On any other version it does nothing.
SUPPORTED_WEBRTC_VERSION = "0.79.1"
COMPONENT_ABSENT_KEY = "live_video_component_absent"

_applied: dict | None = None


def configure_return_video_bitrate(default: int | None = None, minimum: int | None = None, maximum: int | None = None) -> dict:
    """Set aiortc's VP8 encoder bitrate constants for this process. Idempotent; returns the values in use."""
    global _applied
    import aiortc.codecs.vpx as vpx

    d = int(default or RETURN_VIDEO_BITRATE["default"])
    lo = int(minimum or RETURN_VIDEO_BITRATE["min"])
    hi = int(maximum or RETURN_VIDEO_BITRATE["max"])
    if not (0 < lo <= d <= hi):
        raise ValueError(f"invalid bitrate range: min {lo}, default {d}, max {hi}")
    vpx.DEFAULT_BITRATE, vpx.MIN_BITRATE, vpx.MAX_BITRATE = d, lo, hi  # VP8 is the negotiated codec (measured)
    _applied = {"default": d, "min": lo, "max": hi}
    return dict(_applied)


def applied_return_video_bitrate() -> dict | None:
    return dict(_applied) if _applied else None


@lru_cache(maxsize=1)
def guard_supported() -> bool:
    try:
        return metadata.version("streamlit-webrtc") == SUPPORTED_WEBRTC_VERSION
    except metadata.PackageNotFoundError:
        return False


def mark_live_component_absent(state: MutableMapping[str, Any]) -> None:
    """Record a run that does not render the video component, so the library's reset stays active."""
    state[COMPONENT_ABSENT_KEY] = True


def clear_live_component_absent(state: MutableMapping[str, Any]) -> None:
    """Call after webrtc_streamer has returned normally."""
    state.pop(COMPONENT_ABSENT_KEY, None)


def protect_live_stream(state: MutableMapping[str, Any], key: str) -> bool:
    """Call immediately before webrtc_streamer. Returns True when the library's run-count check is skipped for this call."""
    if not guard_supported() or state.get(COMPONENT_ABSENT_KEY, False):
        return False
    context = state.get(key)
    if context is None or not hasattr(context, "_last_rendered_run_count"):
        return False
    context._last_rendered_run_count = None
    return True
